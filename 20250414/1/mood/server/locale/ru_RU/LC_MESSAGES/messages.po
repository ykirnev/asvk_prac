msgid "{username} joined MUD"
msgstr "{username} присоединился к MUD"

msgid "{username} disconnected"
msgstr "{username} отключился"

msgid "Added monster {name} to {pos} saying {hello}"
msgstr "Добавлен монстр {name} на {pos} с приветствием {hello}"

msgid "{username} added monster {name} with {hp} hp"
msgid_plural "{username} added monster {name} with {hp} hps"
msgstr[0] "{username} добавил монстра {name} с {hp} очком здоровья"
msgstr[1] "{username} добавил монстра {name} с {hp} очками здоровья"
msgstr[2] "{username} добавил монстра {name} с {hp} очками здоровья"

msgid "No {name} here"
msgstr "Здесь нет {name}"

msgid "Attacked {name}, damage {damage} hp"
msgid_plural "Attacked {name}, damage {damage} hps"
msgstr[0] "Атакован {name}, урон {damage} очко здоровья"
msgstr[1] "Атакован {name}, урон {damage} очка здоровья"
msgstr[2] "Атакован {name}, урон {damage} очков здоровья"

msgid "{name} now has {hp} hp"
