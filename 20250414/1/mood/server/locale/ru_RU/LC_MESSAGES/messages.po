msgstr[1] "{username} атаковал {name} на {damage} очка здоровья, осталось {hp}"
msgstr[2] "{username} атаковал {name} на {damage} очков здоровья, осталось {hp}"

msgid "{name} moved one cell {direction}"
msgstr "{name} переместился на одну клетку {direction}"

msgid "Moving monsters: {state}"
msgstr "Бродячие монстры: {state}"

msgid "Set up locale: {locale}"
msgstr "Установлена локаль: {locale}"

msgid "{username}: {message}"
msgstr "{username}: {message}"